{
  "name": "extended-find-replace-regex",
  "version": "1.1.0",
  "description": "Search and replace note text with JavaScript regular expressions, lookarounds, selection scoping, reusable presets, and ordered pipelines.",
  "main": "main.js",
  "type": "module",
  "author": "Jason Shelter",
  "repository": {
    "type": "git",
    "url": "https://github.com/jasonshelter0/extended-find-replace-regex.git"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint .",
    "release": "bash release.sh",
    "format": "prettier --write \"src/**/*.ts\" && prettier --write \"*.md\""
  },
  "keywords": ["obsidian", "search", "replace", "regex"],
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "@eslint/js": "9.39.2",
    "@types/node": "^25.8.0",
    "esbuild": "^0.28.0",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "prettier": "^3.8.3",
    "prettier-plugin-sh": "^0.18.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3"
  },
  "dependencies": {
    "obsidian": "latest"
  }
}
